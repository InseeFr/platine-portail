{
  "openapi": "3.1.0",
  "info": {
    "title": "platine-aiguillage-api",
    "description": "Java version: 21",
    "contact": {
      "name": "Plateformes de collecte",
      "email": "service-numerique-plateforme-collecte@insee.fr"
    },
    "version": "2.7.1"
  },
  "servers": [
    { "url": "https://api-enquetes.developpement3.insee.fr", "description": "Generated server url" }
  ],
  "security": [{ "oauth2": ["read", "write"] }],
  "tags": [
    {
      "name": "Actuator",
      "description": "Monitor and interact",
      "externalDocs": {
        "description": "Spring Boot Actuator Web API Documentation",
        "url": "https://docs.spring.io/spring-boot/docs/current/actuator-api/html/"
      }
    }
  ],
  "paths": {
    "/user/mail": {
      "get": {
        "tags": ["User account"],
        "summary": "Récupération du mail du contact",
        "operationId": "mailConsultation",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MailOutput" } } }
          }
        }
      },
      "put": {
        "tags": ["User account"],
        "summary": "Modification du mail du contact",
        "operationId": "mailModification",
        "requestBody": {
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MailInput" } } },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/MailUpdate" } } }
          }
        }
      }
    },
    "/repondant/mail": {
      "get": {
        "tags": ["User account"],
        "summary": "Récupération du mail du contact",
        "operationId": "mailConsultationOld",
        "responses": {
          "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "string" } } } }
        }
      },
      "put": {
        "tags": ["User account"],
        "summary": "Modification du mail du contact",
        "operationId": "mailModificationOld",
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "string" } } },
          "required": true
        },
        "responses": {
          "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "boolean" } } } }
        }
      }
    },
    "/reinit-password": {
      "post": {
        "tags": ["Assistance"],
        "summary": "Reinit password",
        "operationId": "reinitPassword",
        "parameters": [
          { "name": "idec", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/ReinitPasswordStatusDto" } }
            }
          }
        }
      }
    },
    "/e-mail": {
      "post": {
        "tags": ["Assistance"],
        "summary": "Send mail to assistance",
        "operationId": "contactAssistance",
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/MailAssistanceInputDto" } }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "$ref": "#/components/schemas/MailAssistanceStatusDto" } }
            }
          }
        }
      }
    },
    "/sources/ongoing": {
      "get": {
        "tags": ["Assistance"],
        "operationId": "getOpenSources",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SourceOngoingDto" }
                }
              }
            }
          }
        }
      }
    },
    "/questionnaires": {
      "get": {
        "tags": ["Access"],
        "operationId": "getListQuestionnaires",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/QuestionnaireDto" }
                }
              }
            }
          }
        }
      }
    },
    "/questionnaires-url": {
      "get": {
        "tags": ["Access"],
        "operationId": "getUrlRedirection",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Ligne" } } }
            }
          }
        }
      }
    },
    "/is-survey-online/{id}": {
      "get": {
        "tags": ["Access"],
        "summary": "Vérifie si une enquête est ouverte ou fermée",
        "operationId": "isSurveyOnline",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/SurveyStatus" } } }
          }
        }
      }
    },
    "/healthcheck": {
      "get": {
        "tags": ["Healthcheck"],
        "operationId": "healthcheck",
        "responses": {
          "200": {
            "description": "OK",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/HealthcheckDto" } } }
          }
        }
      }
    },
    "/actuator": {
      "get": {
        "tags": ["Actuator"],
        "summary": "Actuator root web endpoint",
        "operationId": "links",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/components/schemas/Link" }
                  }
                }
              },
              "application/vnd.spring-boot.actuator.v2+json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/components/schemas/Link" }
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": { "$ref": "#/components/schemas/Link" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/actuator/health": {
      "get": {
        "tags": ["Actuator"],
        "summary": "Actuator web endpoint 'health'",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/vnd.spring-boot.actuator.v3+json": { "schema": { "type": "object" } },
              "application/vnd.spring-boot.actuator.v2+json": { "schema": { "type": "object" } },
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MailInput": { "type": "object", "properties": { "mail": { "type": "string" } } },
      "MailUpdate": { "type": "object", "properties": { "isUpdate": { "type": "boolean" } } },
      "ReinitPasswordStatusDto": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "status": {
            "type": "string",
            "enum": [
              "100 CONTINUE",
              "101 SWITCHING_PROTOCOLS",
